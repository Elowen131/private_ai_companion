# Android Studio / Gradle will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle 根目录产物（reports 等），本地 flutter build 会生成
/android/build/

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Secrets & signing —— 生产签名密钥与明文密码【绝不入库】
# 当前仓库已存在 android/app/keystore/release.keystore 与 android/key.properties，
# 二者含生产签名证书与明文密码。一旦误提交即等同于密钥泄露，必须忽略。
# 规范：密钥只存本机 + CI Secret / 密钥库，不要把密钥放进源码仓库。
# ---------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pfx
*.pem
key.properties
android/key.properties
android/**/key.properties
/android/app/keystore/
android/app/keystore/**
android/upload-keystore.jks
upload-keystore.jks

# 本地环境配置（可能含 token / 路径）
.env
.env.*
*.env
local.properties
android/local.properties

# Firebase / 第三方密钥配置文件
google-services.json
GoogleService-Info.plist
firebase.json

# ---------------------------------------------------------------------------
# Android 额外标准条目
# ---------------------------------------------------------------------------
/android/.gradle/
/android/captures/
*.apk
*.aab
/android/app/flutter_lib/

